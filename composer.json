{
    "name": "hmmdlthf/filament_refine_filter",
    "description": "A ScriptCase-style 'Refine Search' facet filter for Filament v5 tables — checkbox facets with live counts for BelongsTo relationships and backed PHP enums.",
    "keywords": [
        "laravel",
        "filament",
        "filter",
        "facet",
        "faceted-search",
        "refine-search"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "hmmdlthf"
        }
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0",
        "illuminate/database": "^12.0",
        "illuminate/support": "^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Hmmdlthf\\FilamentRefineFilter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hmmdlthf\\FilamentRefineFilter\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hmmdlthf\\FilamentRefineFilter\\RefineFilterServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
